# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Do not paste this into the Android app.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/workersos?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Development only. Returns the OTP in the API response so the app can be tested
# without an SMS provider. Must be false in production.
OTP_DEBUG=false

# Optional SMS webhook. When set, the server POSTs { mobile, purpose, code }.
SMS_WEBHOOK_URL=

# Comma-separated browser origins for the hospital portal and admin panel.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional private S3-compatible storage. When unset, files stay on local private disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Optional Firebase Admin service account JSON, as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional WhatsApp Business credentials. Messages are skipped when unset.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Optional Razorpay webhook secret. The webhook rejects calls when this is unset.
RAZORPAY_WEBHOOK_SECRET=

# Development seed accounts. Used only by `npm run seed`.
SEED_ADMIN_PASSWORD=Admin#Demo1
SEED_HOSPITAL_PASSWORD=Hospital#Demo1
